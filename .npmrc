dangerouslyAllowAllBuilds=true
# Keep a single React / RN for Expo mobile (invalid hook call under pnpm isolation).
public-hoist-pattern[]=*react*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=@react-native/*
# Reanimated/worklets Babel plugins require @babel/types from the package root.
public-hoist-pattern[]=@babel/*
