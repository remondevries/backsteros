{
  "name": "@backsteros/mobile",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "node ./scripts/with-packager-hostname.mjs expo start",
    "start": "node ./scripts/with-packager-hostname.mjs expo start",
    "build": "node ./scripts/with-packager-hostname.mjs expo run:ios --device",
    "start:dev-client": "node ./scripts/with-packager-hostname.mjs expo start --dev-client",
    "android": "node ./scripts/with-packager-hostname.mjs expo run:android",
    "ios": "node ./scripts/with-packager-hostname.mjs expo run:ios",
    "ios:device": "node ./scripts/with-packager-hostname.mjs expo run:ios --device",
    "ios:release": "expo run:ios --device --configuration Release",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'lib/**/*.test.ts' 'widgets/**/*.test.ts'",
    "build:codemirror": "node scripts/build-codemirror-editor.mjs",
    "build:calendar-webview": "node scripts/build-calendar-webview.mjs",
    "build:agent-terminal": "node scripts/build-agent-terminal.mjs",
    "generate:pierre-icons": "node scripts/generate-pierre-file-icons.mjs",
    "postinstall": "node ./scripts/patch-expo-libghostty-accessory.mjs && node ./scripts/patch-expo-libghostty-mouse.mjs"
  },
