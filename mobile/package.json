{
  "name": "@backsteros/mobile",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "node ./scripts/with-packager-hostname.mjs expo start",
    "start:dev-client": "node ./scripts/with-packager-hostname.mjs expo start --dev-client",
    "android": "node ./scripts/with-packager-hostname.mjs expo run:android",
    "ios": "node ./scripts/with-packager-hostname.mjs expo run:ios",
    "ios:device": "node ./scripts/with-packager-hostname.mjs expo run:ios --device",
    "ios:release": "expo run:ios --device --configuration Release",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'lib/**/*.test.ts'",
    "build:codemirror": "node scripts/build-codemirror-editor.mjs",
    "build:agent-terminal": "node scripts/build-agent-terminal.mjs",
    "postinstall": "node ./scripts/patch-expo-libghostty-accessory.mjs && node ./scripts/patch-expo-libghostty-mouse.mjs"
  },
  "dependencies": {
    "@azure/core-asynciterator-polyfill": "^1.0.2",
    "@babel/runtime": "^7.29.7",
    "@backsteros/api-client": "workspace:*",
    "@backsteros/contracts": "workspace:*",
    "@clerk/clerk-expo": "^2.9.0",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@expo/metro-runtime": "~6.1.2",
    "@lezer/highlight": "^1.2.3",
    "@op-engineering/op-sqlite": "15.2.14",
    "@powersync/adapter-sql-js": "^0.0.18",
    "@powersync/op-sqlite": "0.9.15",
    "@powersync/react-native": "^1.35.9",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/native": "^7.3.11",
    "@replit/codemirror-vim": "^6.3.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "chrono-node": "^2.10.0",
    "expo": "~54.0.0",
    "expo-application": "~7.0.0",
    "expo-auth-session": "~7.0.0",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-constants": "~18.0.0",
    "expo-crypto": "~15.0.0",
    "expo-dev-client": "~6.0.0",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-key-event": "^1.9.0",
    "expo-libghostty": "0.8.1",
    "expo-linking": "~8.0.0",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-status-bar": "~3.0.0",
    "expo-web-browser": "~15.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-apple-key-commands": "^0.1.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-async-generator-functions": "^7.29.7",
    "@babel/types": "^7.29.7",
    "@types/node": "^22.15.0",
    "@types/react": "~19.1.10",
    "esbuild": "^0.25.12",
    "tsx": "^4.23.1",
    "typescript": "~5.9.2"
  }
}
