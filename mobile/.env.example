# Expo public env (embedded in the JS bundle — restart Metro after changes)
#
# Match desktop when you want the same data (e.g. CA-1 on production):
#   EXPO_PUBLIC_API_URL=https://service.backsteros.com
# Local API (Simulator on same Mac):
#   EXPO_PUBLIC_API_URL=http://127.0.0.1:8787
# Physical device + local core over Tailscale MagicDNS:
#   EXPO_PUBLIC_API_URL=http://macbook.YOUR_TAILNET.ts.net:8787
# Physical device + LAN (same Wi‑Fi, no Tailscale):
#   EXPO_PUBLIC_API_URL=http://192.168.x.x:8787
EXPO_PUBLIC_API_URL=http://macbook.YOUR_TAILNET.ts.net:8787
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Metro URL advertised to physical devices (Expo Dev Client).
# Defaults to the hostname from EXPO_PUBLIC_API_URL when not loopback.
# Set explicitly if API and Metro hosts differ:
#   REACT_NATIVE_PACKAGER_HOSTNAME=macbook.YOUR_TAILNET.ts.net
# Or:
#   EXPO_PUBLIC_PACKAGER_HOSTNAME=macbook.YOUR_TAILNET.ts.net


# Optional crash reporting (leave empty for local/dev — Sentry stays disabled)
# EXPO_PUBLIC_SENTRY_DSN=
# When set, install `@sentry/react-native`, add the Expo plugin, and re-run prebuild.

# Prerequisites for Today list:
# - API reachable with Clerk + workspace
# - At least one incomplete task with dueDate on today
# - PowerSync enabled on the API (POWERSYNC_*) for local SQLite lists
# - For Tailscale: set core POWERSYNC_URL to the same MagicDNS host (:8080)
