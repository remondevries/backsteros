{
  "name": "@backsteros/development",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n pty,next -c magenta,cyan \"pnpm pty\" \"next dev --port ${PORT:-3100}\"",
    "pty": "node ./scripts/fix-node-pty-perms.mjs && node ./scripts/pty-server.mjs",
    "postinstall": "node ./scripts/fix-node-pty-perms.mjs",
    "build": "next build",
    "start": "next start --port ${PORT:-3100}",
    "app": "bash ./scripts/launch-console-app.sh",
    "app:install": "bash ./scripts/install-macos-app.sh",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:install": "bash ./scripts/install-tauri-app.sh",
    "tauri": "tauri",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test lib/cursor-agent-cli.test.ts lib/agent-cli-open.test.ts lib/agent-review.test.ts lib/agent-hold.test.ts lib/format-agent-comment-reply-prompt.test.ts lib/agent-launch.test.ts lib/cursor-api-usage.test.ts lib/cursor-plan-usage-shared.test.ts lib/due-date.test.ts"
  },
  "dependencies": {
    "@backsteros/api-client": "workspace:*",
    "@backsteros/contracts": "workspace:*",
    "@backsteros/ui": "workspace:*",
    "@clerk/nextjs": "^6.31.9",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.43.6",
    "@git-diff-view/react": "^0.1.7",
    "@replit/codemirror-vim": "^6.3.0",
    "@uiw/react-codemirror": "^4.25.4",
    "@xterm/addon-canvas": "0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/xterm": "^5.5.0",
    "next": "16.2.11",
    "node-pty": "^1.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.2"
  }
}
