{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BacksterOS Development",
  "version": "0.1.0",
  "identifier": "com.backsteros.development",
  "build": {
    "beforeDevCommand": "bash ./scripts/tauri-dev-sidecar.sh",
    "devUrl": "http://127.0.0.1:3110",
    "frontendDist": "../desktop-shell"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "BacksterOS Development",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 18
        }
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "shortDescription": "BacksterOS Development console",
    "longDescription": "Native window wrapper around the local Next.js development console (PTY + tasks).",
    "copyright": "Copyright © BacksterOS",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
