{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window loads the local Next.js development console",
  "windows": ["main", "oauth-*"],
  "remote": {
    "urls": [
      "http://localhost:3100",
      "http://localhost:3100/**",
      "http://127.0.0.1:3100",
      "http://127.0.0.1:3100/**",
      "https://*.clerk.accounts.dev",
      "https://*.clerk.accounts.dev/**",
      "https://clerk.accounts.dev",
      "https://clerk.accounts.dev/**",
      "https://*.accounts.dev",
      "https://*.accounts.dev/**",
      "https://*.clerk.com",
      "https://*.clerk.com/**",
      "https://accounts.google.com",
      "https://accounts.google.com/**",
      "https://github.com",
      "https://github.com/**",
      "https://*.github.com",
      "https://*.github.com/**",
      "https://tender-caiman-58.clerk.accounts.dev",
      "https://tender-caiman-58.clerk.accounts.dev/**",
      "https://clerk.shared.lcl.dev",
      "https://clerk.shared.lcl.dev/**",
      "https://*.lcl.dev",
      "https://*.lcl.dev/**"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default"
  ]
}
