# Copy to gitignored paths by scripts/dev-server.sh (never commit secrets):
#   core/server/.env
#   backsteros/.env
#   .env.development (compose + script defaults)
#
# Dev-only values for the Ubuntu development server (Tailscale 100.126.31.97).
# HTTPS same-origin gateway (ops-owned nginx, do not edit): https://dev-os.lemo-design.com

# --- compose / script ---
BACKSTEROS_COMPOSE_PROJECT=backsteros-devserver
COMPOSE_PROJECT_NAME=backsteros-devserver
POSTGRES_USER=backsteros
POSTGRES_PASSWORD=backsteros_dev_only
POSTGRES_DB=backsteros
DEV_SERVER_TAILSCALE_IP=100.126.31.97
DEV_SERVER_PUBLIC_HOST=dev-os.lemo-design.com
DEV_SERVER_TMUX_SESSION=backsteros-dev

# --- core/server/.env ---
DATABASE_URL=postgresql://backsteros:backsteros_dev_only@127.0.0.1:5433/backsteros
PORT=8788
HOST=100.126.31.97
NODE_ENV=development
LOG_LEVEL=info
PUBLIC_API_URL=https://dev-os.lemo-design.com
CORS_ORIGINS=https://dev-os.lemo-design.com,http://100.126.31.97:1420,http://development:1420,http://127.0.0.1:1420,http://localhost:1420,tauri://localhost,https://tauri.localhost
LOCAL_SHELL_AUTH=1
LOCAL_SHELL_TOKEN=local
# Match deploy/powersync/service.local.yaml `client_auth.jwks.keys[0].k` (base64url of this secret).
POWERSYNC_JWT_SECRET=PhusPC__XjONaDuOHFIEcJF8bKH-PnyblObbfJO7yz8
POWERSYNC_AUDIENCE=backsteros-powersync
# Browser clients use the HTTPS gateway; nginx strips /powersync/ → :8080.
POWERSYNC_URL=https://dev-os.lemo-design.com/powersync
POWERSYNC_LOCAL_URL=http://127.0.0.1:8080
BACKSTEROS_VAULT_PATH=/home/deploy/.backsteros/dev-server-vault
# No CORE_REPLICATION_* — this stack must not talk to live/cloud cores.

# --- backsteros/.env ---
VITE_API_URL=https://dev-os.lemo-design.com
VITE_TREAT_API_AS_LOCAL_CORE=1
VITE_DEV_SERVER_HOST=dev-os.lemo-design.com
VITE_LOCAL_SHELL_TOKEN=local
TAURI_DEV_HOST=100.126.31.97
DEV_PUBLIC_HOST=dev-os.lemo-design.com
