# Copy to ~/.config/backsteros/local-core.env (LaunchAgent + scripts/local-core/run.sh).
# Keep secrets out of the developer checkout's core/server/.env when possible.
#
# Prefer the full set from a working core/server/.env (DATABASE_URL, replication,
# PowerSync JWT, vault path, CORS, …). Minimum keys below keep the API booting.
# Postgres (local-core Docker). Bind is 127.0.0.1:5433 in docker-compose.yml.
# Password: copy POSTGRES_PASSWORD from Infisical (~/.config/secrets/local.env)
# into this file. Never use the default `backsteros`. Never commit this file.
# POSTGRES_PASSWORD=
DATABASE_URL=postgresql://backsteros:REPLACE_WITH_POSTGRES_PASSWORD@127.0.0.1:5433/backsteros
PORT=8788
HOST=127.0.0.1

# OS-49 safeguard: set to 0 to skip peer sync_events pull while table LWW continues.
# Keep at 1 when replay stamping is fixed (OS-73 deliberately re-enabled this).
CORE_REPLICATION_SYNC_EVENTS_PULL=1

# Also typically required (copy from core/server/.env — do not commit secrets):
# CORE_REPLICATION_PEER_URL=
# CORE_REPLICATION_SECRET=
# CORE_REPLICATION_ROLE=local
# CORE_REPLICATION_WORKSPACE_IDS=
# POWERSYNC_URL=
# POWERSYNC_JWT_SECRET=
# POWERSYNC_AUDIENCE=
# BACKSTEROS_VAULT_PATH=
# CORS_ORIGINS=
# PUBLIC_API_URL=
#
# Do NOT set AGENTS_PUBLIC_URL on local-core (OS-100). Email-agent / file-task
# callbacks and AgentMail inbound webhooks belong on cloud-core via
# https://agent.backsteros.com. A stale staging URL would mint dead callbacks.
