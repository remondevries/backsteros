# Copy to ~/.config/backsteros/local-core.env (LaunchAgent + scripts/local-core/run.sh).
# Keep secrets out of the developer checkout's core/server/.env when possible.
#
# Required for local-core API + replication (see core/server/.env.example for full list).
DATABASE_URL=postgresql://backsteros:backsteros@127.0.0.1:5433/backsteros
PORT=8788
HOST=127.0.0.1

# OS-49 safeguard: set to 0 to skip peer sync_events pull while table LWW continues.
# Omit or set to 1 when replay stamping is fixed.
# CORE_REPLICATION_SYNC_EVENTS_PULL=0
