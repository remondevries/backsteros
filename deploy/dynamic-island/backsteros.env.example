# Dynamic Island menu-bar app reads ~/.config/dynamic-island/backsteros.env
# (not the repo). Use a live BacksterOS API key — not a revoked bootstrap key.
#
# Create/update:
#   cp deploy/dynamic-island/backsteros.env.example ~/.config/dynamic-island/backsteros.env
#   # set BACKSTEROS_API_KEY from ~/.config/backsteros/cli.env (sk_live_… with tasks:read)
BACKSTEROS_API_URL=https://api.local.backsteros.com
BACKSTEROS_API_KEY=
