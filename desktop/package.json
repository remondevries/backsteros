{
  "name": "@backsteros/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/copy-pdf-worker.mjs && node scripts/copy-powersync-assets.mjs",
    "build": "node scripts/copy-pdf-worker.mjs && node scripts/copy-powersync-assets.mjs && tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "whoop:fetch": "node ./scripts/whoop/fetch-day.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "pty": "node ./scripts/run-pty-tailscale.mjs",
    "pty:local": "node ./scripts/fix-node-pty-perms.mjs && node ./scripts/pty-server.mjs",
    "pty:tailscale": "node ./scripts/run-pty-tailscale.mjs",
    "postinstall": "node scripts/copy-pdf-worker.mjs && node scripts/copy-powersync-assets.mjs && node ./scripts/fix-node-pty-perms.mjs && node ./scripts/whoop/build-totem.mjs"
  },
  "dependencies": {
    "@backsteros/api-client": "workspace:*",
    "@backsteros/contracts": "workspace:*",
    "@backsteros/powersync-schema": "workspace:*",
    "@backsteros/ui": "workspace:*",
    "@briangaoo/totem": "git+https://github.com/briangaoo/totem.git#586ee89d0ec8f8ba4a142c824ecaeea7faaa200b",
    "@clerk/clerk-react": "^5.31.4",
    "@journeyapps/wa-sqlite": "^1.7.2",
    "@lexical/react": "^0.41.0",
    "@pierre/diffs": "^1.2.12",
    "@pierre/trees": "1.0.0-beta.4",
    "@powersync/web": "^1.39.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-canvas": "0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "lexical": "^0.41.0",
    "lucide-react": "^0.564.0",
    "pdfjs-dist": "5.4.296",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-pdf": "^10.4.1",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.6.0",
    "node-pty": "^1.0.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-top-level-await": "^1.5.0",
    "vite-plugin-wasm": "^3.4.1",
    "ws": "^8.18.3"
  }
