{
  "name": "@backsteros/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pdf-worker.mjs && node scripts/copy-powersync-assets.mjs",
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:vite": "vite",
    "predev:vite": "node scripts/copy-pdf-worker.mjs && node scripts/copy-powersync-assets.mjs",
    "build:web": "node scripts/copy-pdf-worker.mjs && node scripts/copy-powersync-assets.mjs && tsc && vite build",
    "build:report": "node scripts/copy-pdf-worker.mjs && node scripts/copy-powersync-assets.mjs && tsc && BUNDLE_REPORT=1 vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --import ./src/test/node-test-setup.mjs --test 'src/**/*.test.ts'",
    "lint": "eslint src packages/ui/src",
    "whoop:fetch": "node ./scripts/whoop/fetch-day.mjs",
    "tauri": "tauri",
    "pty": "node ./scripts/run-pty-tailscale.mjs",
    "pty:local": "node ./scripts/fix-node-pty-perms.mjs && node ./scripts/pty-server.mjs",
    "pty:tailscale": "node ./scripts/run-pty-tailscale.mjs",
    "postinstall": "node scripts/copy-pdf-worker.mjs && node scripts/copy-powersync-assets.mjs && node ./scripts/fix-node-pty-perms.mjs && node ./scripts/whoop/build-totem.mjs"
  },
  "dependencies": {
    "@backsteros/api-client": "workspace:*",
    "@backsteros/contracts": "workspace:*",
    "@backsteros/powersync-schema": "workspace:*",
    "@backsteros/ui": "workspace:*",
    "@briangaoo/totem": "git+https://github.com/briangaoo/totem.git#586ee89d0ec8f8ba4a142c824ecaeea7faaa200b",
    "@clerk/clerk-react": "^5.31.4",
    "@journeyapps/wa-sqlite": "^1.7.2",
    "@legendapp/list": "3.2.0",
    "@powersync/web": "^1.39.0",
    "@tanstack/react-router": "^1.170.32",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.564.0",
    "pdfjs-dist": "5.4.296",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-pdf": "^10.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/cli": "^2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "node-pty": "^1.0.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.0.4",
    "vite-plugin-top-level-await": "^1.5.0",
    "vite-plugin-wasm": "^3.4.1",
    "ws": "^8.18.3"
  }
}
