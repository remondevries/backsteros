# Cloud-core API (no trailing slash). Product desktop syncs here, not to local Docker.
VITE_API_URL=http://100.75.45.22:8788

# Owner key is read from ~/.config/backsteros/cli.env (BACKSTEROS_API_KEY).
# Optional override for tests. Must be sk_live_…. Never use Bearer local.
# VITE_OWNER_API_KEY=

# Optional Mac working copy. Not fetched from cloud-core (vaultPath stays off sync).
# VITE_BACKSTEROS_VAULT_PATH=/Users/you/BacksterOS

# Optional canonical URL for “Open in browser” style links (no public product web in v2).
# VITE_APP_URL=

# Optional: PTY sidecar (defaults to ws://127.0.0.1:3101).
# When the sidecar sets PTY_AUTH_TOKEN (Tailscale / non-loopback bind), set the
# same value here so desktop HTTP/WS clients authenticate.
# VITE_PTY_WS_URL=ws://127.0.0.1:3101
# VITE_PTY_HTTP_URL=http://127.0.0.1:3101
# VITE_PTY_AUTH_TOKEN=
