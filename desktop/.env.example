# Local core API (no trailing slash). v2 desktop always targets local core.
VITE_API_URL=http://127.0.0.1:8788

# Optional local-shell bearer (default: `local`). Must match core
# LOCAL_SHELL_TOKEN when set. Lets the app open without a sign-in screen.
# VITE_LOCAL_SHELL_TOKEN=local

# Canonical web product URL (optional “Open in browser” later).
VITE_APP_URL=https://backsteros.com/app

# Optional: PTY sidecar (defaults to ws://127.0.0.1:3101).
# When the sidecar sets PTY_AUTH_TOKEN (Tailscale / non-loopback bind), set the
# same value here so desktop HTTP/WS clients authenticate.
# VITE_PTY_WS_URL=ws://127.0.0.1:3101
# VITE_PTY_HTTP_URL=http://127.0.0.1:3101
# VITE_PTY_AUTH_TOKEN=
