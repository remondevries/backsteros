# Local core API (no trailing slash). v2 desktop always targets local core.
VITE_API_URL=http://127.0.0.1:8788

# Optional local-shell bearer (default: `local`). Must match core
# LOCAL_SHELL_TOKEN when set. Lets the app open without Clerk sign-in.
# VITE_LOCAL_SHELL_TOKEN=local

# Clerk publishable key (SPA / Tauri — optional). Used for GitHub connect /
# account profile. The product shell opens via local-shell auth without it.
#
# In Clerk Dashboard → Configure → Domains / Allowed origins, add
# (required for packaged OAuth — without these, GitHub/account linking fails):
#   http://localhost:1420
#   http://127.0.0.1:1420
#   tauri://localhost
#   https://tauri.localhost
#
# Also allow redirect URLs for GitHub connect (Settings → GitHub):
#   http://localhost:1420/sso-callback
#   http://127.0.0.1:1420/sso-callback
#   tauri://localhost/sso-callback
#   https://tauri.localhost/sso-callback
#   tauri://localhost/oauth/popup-done
#   https://tauri.localhost/oauth/popup-done
#
# Local core CORS must also allow those origins (see core/server/.env
# CORS_ORIGINS). Restart the API after changing CORS.
VITE_CLERK_PUBLISHABLE_KEY=

# Canonical web product URL (optional “Open in browser” later).
VITE_APP_URL=https://backsteros.com/app

# Optional: PTY sidecar (defaults to ws://127.0.0.1:3101).
# When the sidecar sets PTY_AUTH_TOKEN (Tailscale / non-loopback bind), set the
# same value here so desktop HTTP/WS clients authenticate.
# VITE_PTY_WS_URL=ws://127.0.0.1:3101
# VITE_PTY_HTTP_URL=http://127.0.0.1:3101
# VITE_PTY_AUTH_TOKEN=
