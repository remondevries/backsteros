{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and compose overlay",
  "windows": ["main", "overlay"],
  "remote": {
    "urls": [
      "http://localhost:1420",
      "http://localhost:1420/**",
      "http://127.0.0.1:1420",
      "http://127.0.0.1:1420/**"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "opener:default",
    "dialog:default",
    "notification:default",
    "fs:allow-home-read-recursive",
    "fs:allow-home-write-recursive",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME" },
        { "path": "$HOME/**" },
        { "path": "/tmp/dynamic-island-tasks-refresh" },
        { "path": "/tmp/backsteros-open-href" },
        { "path": "/Volumes" },
        { "path": "/Volumes/**" },
        { "path": "/Users" },
        { "path": "/Users/**" }
      ]
    },
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "allow-desktop-overlay",
    "allow-whoop",
    "allow-system-stats",
    "allow-cursor-usage"
  ]
}
