{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window, compose overlay, and OAuth popups",
  "windows": ["main", "overlay", "oauth-*"],
  "remote": {
    "urls": [
      "http://localhost:1420",
      "http://localhost:1420/**",
      "http://127.0.0.1:1420",
      "http://127.0.0.1:1420/**"
    ]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:allow-home-read-recursive",
    "fs:allow-home-write-recursive",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME" },
        { "path": "$HOME/**" },
        { "path": "/Volumes" },
        { "path": "/Volumes/**" },
        { "path": "/Users" },
        { "path": "/Users/**" }
      ]
    },
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "allow-desktop-overlay",
    "allow-whoop",
    "allow-system-stats",
    "allow-oauth-windows",
    "allow-agent-browser"
  ]
}
