{
  "name": "@backsteros/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "react-server": "./dist/server.js",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./shell": {
      "types": "./dist/entry/shell.d.ts",
      "import": "./dist/entry/shell.js",
      "default": "./dist/entry/shell.js"
    },
    "./tasks": {
      "types": "./dist/entry/tasks.d.ts",
      "import": "./dist/entry/tasks.js",
      "default": "./dist/entry/tasks.js"
    },
    "./inbox": {
      "types": "./dist/entry/inbox.d.ts",
      "import": "./dist/entry/inbox.js",
      "default": "./dist/entry/inbox.js"
    },
    "./calendar": {
      "types": "./dist/entry/calendar.d.ts",
      "import": "./dist/entry/calendar.js",
      "default": "./dist/entry/calendar.js"
    },
    "./navigation": {
      "types": "./dist/entry/navigation.d.ts",
      "import": "./dist/entry/navigation.js",
      "default": "./dist/entry/navigation.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind.css": "./src/tailwind.css"
  },
  "scripts": {
    "build": "tsc && node ./scripts/copy-styles.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'src/**/*.test.ts'"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "@backsteros/contracts": "workspace:*",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
