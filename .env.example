# Local dev (copy to core/server/.env)
DATABASE_URL=postgresql://backsteros:backsteros@localhost:5433/backsteros

# Clerk — from https://dashboard.clerk.com
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Server
PORT=8788
HOST=127.0.0.1
NODE_ENV=development

# Comma-separated origins for CORS (include local Vite / Tauri origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,https://tauri.localhost,http://localhost:3000,http://127.0.0.1:3000

# Core replication (local-core ↔ cloud-core). Peer is the OTHER CORE directly
# (Tailscale MagicDNS or localhost) — never https://agent.backsteros.com (agents door).
# CORE_REPLICATION_PEER_URL=http://macbook.tail1234.ts.net:8788
# CORE_REPLICATION_SECRET=
# CORE_REPLICATION_ROLE=local
