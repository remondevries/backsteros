{
  "name": "@backsteros/design-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BacksterDESIGN Tauri desktop shell — overlay chrome + single Penpot webview",
  "verifyDepsBeforeRun": false,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "PENPOT_PUBLIC_URI=https://localhost:3449 tauri dev",
    "tauri:dev:hosted": "PENPOT_PUBLIC_URI=https://design.lemo-design.com tauri dev",
    "tauri:build": "tauri build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@backsteros/ui": "workspace:*",
    "@tauri-apps/api": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.5.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
