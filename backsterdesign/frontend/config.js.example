// Copy to config.js (gitignored) for local BacksterDESIGN devenv.
// Or let `pnpm --filter @backsteros/design dev` seed a default.

var penpotFlags = "disable-dashboard-templates-section";

// Bridge to BacksterOS cloud-core (Projects + Clients + timer chrome).
// Use the public agents door so local DESIGN matches OS / DEV timers.
// Hosted design.lemo-design.com keeps baseUrl "/backsteros-core" (Caddy → VPS).
window.backsterosCore = {
  baseUrl: "https://agent.backsteros.com",
  // Owner sk_live_… from ~/.config/backsteros/cli.env (seeded by backster-dev.sh).
  // Needs projects:read + projects:write (link penpotProjectId),
  // tasks:read + tasks:write (project page task list + timers), and
  // contacts:read + contacts:write (Client accounts project allowlist).
  apiKey: "sk_live_REPLACE_ME",
};
