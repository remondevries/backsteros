# Copy to .env on lemodesign (never commit .env).
PENPOT_IMAGE_TAG=2.18.3
PENPOT_UPSTREAM_VERSION=2.18
PENPOT_PUBLIC_URI=https://design.lemo-design.com

# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PENPOT_SECRET_KEY=replace-with-secrets-token-urlsafe-64

# Postgres password for the compose DB (change in production).
PENPOT_DATABASE_PASSWORD=penpot

# Object storage: Cloudflare R2 (S3 API). Do not use the server disk.
# Uses the private BacksterOS bucket. Keys: ~/.config/secrets/backsteros-r2.env
PENPOT_OBJECTS_STORAGE_S3_REGION=auto
PENPOT_OBJECTS_STORAGE_S3_BUCKET=backsteros-files
PENPOT_OBJECTS_STORAGE_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
PENPOT_FILE_DATA_BACKEND=storage
AWS_ACCESS_KEY_ID=replace-with-r2-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key

# BacksterOS cloud-core for the Projects / Clients tabs (written into config.js).
# Served to the browser as window.backsterosCore; Caddy proxies /backsteros-core → agent.
BACKSTEROS_API_KEY=sk_live_replace-me
# Optional override; default is the same-origin proxy path.
# BACKSTEROS_CORE_BASE_URL=/backsteros-core

# Optional real SMTP (defaults to internal mailcatch).
# PENPOT_SMTP_HOST=smtp.example.com
# PENPOT_SMTP_PORT=587
# PENPOT_SMTP_USERNAME=
# PENPOT_SMTP_PASSWORD=
# PENPOT_SMTP_TLS=true
# PENPOT_SMTP_SSL=false
# PENPOT_SMTP_DEFAULT_FROM=no-reply@lemo-design.com
# PENPOT_SMTP_DEFAULT_REPLY_TO=no-reply@lemo-design.com
