# Committed env for automated integration tests (Docker Postgres from repo compose).
# One command from repo root: pnpm test:integration
# Uses backsteros_test — never the live local-core database (backsteros).
DATABASE_URL=postgresql://backsteros:backsteros@127.0.0.1:5433/backsteros_test
HOST=127.0.0.1
PORT=8788
PUBLIC_API_URL=http://127.0.0.1:8788
CORS_ORIGINS=http://127.0.0.1:5173
