{
  "name": "@backsteros/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "dev:watch-contracts": "tsx watch --env-file=.env --watch ../packages/contracts/dist src/index.ts",
    "predev": "pnpm --filter @backsteros/contracts build",
    "build": "pnpm --filter @backsteros/contracts build && tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "tsx --test \"src/lib/**/*.test.ts\" \"src/services/**/*.test.ts\"",
    "test:integration": "tsx --test \"src/integration/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:powersync-setup": "tsx --env-file=.env src/db/powersync-setup.ts",
    "db:powersync-verify": "tsx --env-file=.env src/db/powersync-verify.ts",
    "db:powersync-token": "tsx --env-file=.env src/db/powersync-token.ts",
    "db:seed": "tsx --env-file=.env src/db/seed.ts",
    "replication:bootstrap": "tsx --env-file=.env src/scripts/replication-bootstrap.ts",
    "prove:crm-powersync-leader": "tsx --env-file=.env src/scripts/prove-crm-powersync-leader-write.ts",
    "vault:pull-until-done": "tsx --env-file=.env src/scripts/vault-pull-until-done.ts",
    "vault:reconcile-check": "tsx --env-file=.env src/scripts/vault-reconcile-check.ts",
    "vault:reconcile-metadata": "tsx --env-file=.env src/scripts/vault-reconcile-metadata.ts",
    "postinstall": "node ./scripts/whoop/build-totem.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.848.0",
    "@backsteros/contracts": "workspace:*",
    "@briangaoo/totem": "git+https://github.com/briangaoo/totem.git#586ee89d0ec8f8ba4a142c824ecaeea7faaa200b",
    "@clerk/backend": "^1.34.0",
    "@cursor/sdk": "^1.0.24",
    "@hono/node-server": "^1.14.4",
    "@hono/zod-validator": "^0.4.3",
    "@ts-rest/core": "^3.52.1",
    "@ts-rest/open-api": "^3.52.1",
    "drizzle-orm": "^0.44.2",
    "hono": "^4.12.30",
    "jose": "^6.0.11",
    "nanoid": "^5.1.5",
    "postgres": "^3.4.7",
    "svix": "^1.99.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
