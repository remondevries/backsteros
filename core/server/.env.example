DATABASE_URL=postgresql://backsteros:backsteros@localhost:5433/backsteros
CLERK_SECRET_KEY=sk_test_replace_me
PORT=8788
HOST=127.0.0.1
PUBLIC_API_URL=http://localhost:8788
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,https://tauri.localhost,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100

# DigitalOcean Spaces — removed for v2 local vault. Prefer BACKSTEROS_VAULT_PATH
# or Settings → Storage (stored in workspace settings).

# Local Obsidian-style vault (markdown + letter PDFs on disk)
# BACKSTEROS_VAULT_PATH=/Users/you/Documents/BacksterOS-Vault

# Optional: Whoop tokens for journal sleep/recovery/strain rings (mobile + desktop).
# Defaults to ~/.backsteros-agent/totem.env
# TOTEM_ENV_PATH=/Users/you/.backsteros-agent/totem.env
# WHOOP_TIMEZONE=Europe/Amsterdam

# PowerSync (Phase 3)
# Generate strong secrets (e.g. openssl rand -base64 48). Never use the example JWT string in prod.
# Local / Simulator: http://localhost:8080
# Phone over Tailscale: http://macbook.YOUR_TAILNET.ts.net:8080 (must be reachable from the device)
POWERSYNC_URL=http://localhost:8080
POWERSYNC_AUDIENCE=backsteros-powersync
POWERSYNC_JWT_SECRET=
POWERSYNC_DB_PASSWORD=

# Agent PTY discovery for Tailscale-trusted shells (iPad codebase task TUI).
# Must match the desktop sidecar: PTY_HOST + PTY_AUTH_TOKEN / pnpm pty.
# AGENT_PTY_PUBLIC_URL=http://macbook.YOUR_TAILNET.ts.net:3101
# AGENT_PTY_AUTH_TOKEN=

# Set to 1 only for local Circle migrate (never in production). Lets the first Clerk user claim ws_legacy_default.
# ALLOW_LEGACY_WORKSPACE_CLAIM=1

# Optional comma-separated workspace user ids allowed to call /api/v1/ops/*
# (in addition to workspace members with role=owner).
# ADMIN_OWNER_USER_IDS=

# Core replication (local-core ↔ cloud-core). Peer = the OTHER CORE directly
# (Tailscale MagicDNS or localhost). Never https://agent.backsteros.com — the
# agents door does not forward /internal/core-replication.
# CORE_REPLICATION_PEER_URL=http://macbook.YOUR_TAILNET.ts.net:8788
# CORE_REPLICATION_SECRET=
# CORE_REPLICATION_ROLE=local
