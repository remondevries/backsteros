DATABASE_URL=postgresql://backsteros:backsteros@localhost:5433/backsteros
PORT=8788
HOST=127.0.0.1
PUBLIC_API_URL=http://localhost:8788
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,https://tauri.localhost,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100

# DigitalOcean Spaces — removed for v2 local vault. Prefer BACKSTEROS_VAULT_PATH
# or Settings → Storage (stored in workspace settings).

# Local Obsidian-style vault (markdown + letter PDFs on disk)
# BACKSTEROS_VAULT_PATH=/Users/you/Documents/BacksterOS-Vault

# Optional: Client portal base URL for staff password-reset emails from desktop.
# CLIENT_PORTAL_URL=http://localhost:3000
# CLIENT_PORTAL_HOOK_SECRET=  # must match portal PORTAL_INTERNAL_HOOK_SECRET (or portal BACKSTEROS_API_KEY)
# Automatic portal meeting reminders (~1h before start). Local-core sends when
# online; cloud-core sends only when local is unreachable (peer ping).
# MEETING_PORTAL_REMINDER_SCHEDULER=0
# MEETING_PORTAL_REMINDER_LEAD_MS=3600000

# Optional: Whoop tokens for journal sleep/recovery/strain rings (mobile + desktop).
# Defaults to ~/.backsteros-agent/totem.env
# TOTEM_ENV_PATH=/Users/you/.backsteros-agent/totem.env
# WHOOP_TIMEZONE=Europe/Amsterdam

# Optional: public HTTPS base of the agents VPS door (no trailing slash).
# Used to auto-register AgentMail inbound webhooks and mint file-task callback URLs.
# AGENTS_PUBLIC_URL=https://agent.backsteros.com
# FILE_TASK_CALLBACK_PUBLIC_URL=https://agent.backsteros.com

# Signed public avatar URLs (Chatwoot, embeds, etc.).
# PUBLIC_API_URL is the absolute origin baked into minted links (already set above).
# Generate a strong secret: openssl rand -hex 32
# AVATAR_URL_SIGNING_SECRET=

# PowerSync (Phase 3)
# Generate strong secrets (e.g. openssl rand -base64 48). Never use the example JWT string in prod.
# Local / Simulator: http://localhost:8080
# Phone over Tailscale: http://macbook.YOUR_TAILNET.ts.net:8080 (must be reachable from the device)
POWERSYNC_URL=http://localhost:8080
POWERSYNC_AUDIENCE=backsteros-powersync
POWERSYNC_JWT_SECRET=
POWERSYNC_DB_PASSWORD=

# Agent PTY discovery for Tailscale-trusted shells (iPad codebase task TUI).
# Must match the desktop sidecar: PTY_HOST + PTY_AUTH_TOKEN / pnpm pty.
# AGENT_PTY_PUBLIC_URL=http://macbook.YOUR_TAILNET.ts.net:3101
# AGENT_PTY_AUTH_TOKEN=

# Optional: GitHub PAT fallback when Settings → GitHub has no token saved.
# Prefer ~/.config/secrets/github.env (Infisical `services` → refresh-secrets).
# Env aliases also work: GITHUB_API_TOKEN, GITHUB_TOKEN, GH_TOKEN.
# GITHUB_API_TOKEN=ghp_...

# Optional: TransIP access token for Catalog → Domains sync.
# Prefer Settings → Integrations → TransIP. Env / ~/.config/secrets/transip.env
# remains a fallback when no workspace token is saved.
# TRANSIP_ACCESS_TOKEN=

# Optional: Cloudflare API token for Catalog → Domains zone matching.
# Prefer Settings → Integrations → Cloudflare. Env / ~/.config/secrets/cloudflare.env
# remains a fallback when no workspace token is saved.
# CLOUDFLARE_API_TOKEN=

# Local shell auth (desktop/mobile on local-core). Default bearer: `local`.
# Disabled automatically when CORE_REPLICATION_ROLE=cloud. Set LOCAL_SHELL_AUTH=0
# to disable on local-core. Optional: LOCAL_SHELL_TOKEN=your-secret
# LOCAL_SHELL_AUTH=1
# LOCAL_SHELL_TOKEN=local

# Set to 1 only for local Circle migrate (never in production). Lets the first
# local-shell owner claim ws_legacy_default.
# ALLOW_LEGACY_WORKSPACE_CLAIM=1

# Optional comma-separated workspace user ids allowed to call /api/v1/ops/*
# (in addition to workspace members with role=owner).
# ADMIN_OWNER_USER_IDS=

# Core replication (local-core ↔ cloud-core). Peer = the OTHER CORE directly
# (Tailscale MagicDNS or localhost). Never https://agent.backsteros.com — the
# agents door does not forward /internal/core-replication.
# CORE_REPLICATION_PEER_URL=http://macbook.YOUR_TAILNET.ts.net:8788
# CORE_REPLICATION_SECRET=
# CORE_REPLICATION_ROLE=local
