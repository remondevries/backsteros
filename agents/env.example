# Tailscale-reachable core API (MagicDNS or 100.x address). No trailing slash.
CORE_UPSTREAM_URL=http://your-machine.tail1234.ts.net:8788

# Listen on loopback; Caddy on the VPS terminates TLS and proxies locally.
PORT=3080
LISTEN_HOST=127.0.0.1

# Optional upstream fetch timeout (milliseconds)
# REQUEST_TIMEOUT_MS=120000
