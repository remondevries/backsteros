# Upstream core API — no trailing slash.
# On the VPS next to cloud-core, prefer loopback (works when the laptop is off):
CORE_UPSTREAM_URL=http://127.0.0.1:8788
#
# Legacy (laptop-only core over Tailscale) — do not use for always-on agents:
# CORE_UPSTREAM_URL=http://macbook.tail1234.ts.net:8788

# Listen on loopback; nginx/Caddy on the VPS terminates TLS and proxies locally.
PORT=3080
LISTEN_HOST=127.0.0.1

# Optional upstream fetch timeout (milliseconds)
# REQUEST_TIMEOUT_MS=120000
