!.env.example
.DS_Store
.env
.env.*
core/server/build-info.json
.migration-reports/
.turbo/
# Drizzle Kit writes snapshots under meta/; the migration journal must always be committed.
**/drizzle/meta/*
!**/drizzle/meta/_journal.json
dist/
node_modules/
tmp/

# Apple codesign / notarization exports — never commit.
*.p12
AuthKey*.p8
certificate-base64.txt
apple-codesign.p12

# Cloud PowerSync config rendered from secrets.
deploy/cloud/powersync.generated.yaml

# Accidental tsc emit into src shadows .ts under Vite (.js wins).
desktop/packages/ui/src/**/*.js

