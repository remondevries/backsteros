{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BacksterOS Hub",
  "version": "0.1.0",
  "identifier": "com.backsteros.hub",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BacksterOS Hub",
        "width": 1,
        "height": 1,
        "visible": false,
        "decorations": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": false,
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Utilities",
    "shortDescription": "BacksterOS local service hub",
    "longDescription": "Menu-bar control to start and stop Docker, core API, and PTY for BacksterOS.",
    "copyright": "Copyright © BacksterOS",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
