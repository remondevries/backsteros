# Copy to ~/.config/secrets/apple-developer.env (chmod 600).
# Never commit the copy. Do not put these values in desktop/.env (Vite would bundle them).
#
# Used by:
#   node desktop/scripts/with-apple-signing.mjs -- pnpm --filter @backsteros/desktop build
#   node desktop/scripts/with-apple-signing.mjs -- pnpm --filter @backsteros/hub build
#   node …/desktop/scripts/with-apple-signing.mjs -- npm run build:app   # Dynamic Island (BOM)
#
# Apple Development certificates cannot notarize. Identity must be Developer ID Application.

APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"
APPLE_TEAM_ID=

# Preferred notarization: App Store Connect API key (Issuer ID + Key ID + .p8 path).
APPLE_API_ISSUER=
APPLE_API_KEY=
APPLE_API_KEY_PATH=

# Alternative notarization: Apple ID + app-specific password (not your account password).
# APPLE_ID=
# APPLE_PASSWORD=
