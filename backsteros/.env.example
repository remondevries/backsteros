# Product desktop talks to local-core by default (LaunchAgent on :8788).
VITE_API_URL=http://127.0.0.1:8788

# Optional: Caddy HTTPS gateway to cloud-core instead of local-core:
# VITE_API_URL=https://api.local.backsteros.com

# Owner key is read from ~/.config/backsteros/cli.env (BACKSTEROS_API_KEY).
# Optional override for tests. Must be sk_live_…. Never use Bearer local.
# VITE_OWNER_API_KEY=

# Optional Mac working copy. Not fetched from cloud-core (vaultPath stays off sync).
# VITE_BACKSTEROS_VAULT_PATH=/Users/you/BacksterOS

# Optional canonical URL for “Open in browser” style links (no public product web in v2).
# VITE_APP_URL=

# Brandfetch Logo CDN client ID (public) — desktop <img> hotlinks when no stored avatar.
# Free at https://developers.brandfetch.com
# VITE_BRANDFETCH_CLIENT_ID=
# Brand API key lives in Settings → Integrations → Brandfetch (workspace secrets).
# Optional server bootstrap only (same pattern as GITHUB_API_TOKEN):
# BRANDFETCH_API_KEY=

# PTY sidecar (defaults to ws://127.0.0.1:3101).
# Required for the codebase task Terminal tab: set the same value as the
# sidecar PTY_AUTH_TOKEN (task-shell fails closed when unset). Also required
# when the sidecar binds beyond loopback (Tailscale).
# VITE_PTY_WS_URL=ws://127.0.0.1:3101
# VITE_PTY_HTTP_URL=http://127.0.0.1:3101
# VITE_PTY_AUTH_TOKEN=
