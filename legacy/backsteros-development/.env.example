# Browser-safe Clerk key. Required for sign-in.
# Without it the console shows a configure-auth screen (no demo fixtures).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Optional server Clerk key (needed if you add Clerk middleware later).
CLERK_SECRET_KEY=

# API origin only (no /api/v1 suffix). The Next app proxies /api/v1/* here
# (avoids CORS). Use production to see the same projects as desktop, or local:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8787
NEXT_PUBLIC_API_URL=https://service.backsteros.com

# Local PTY bridge (started by `pnpm dev`). Bind is 127.0.0.1 only.
# NEXT_PUBLIC_PTY_WS_URL=ws://127.0.0.1:3101
# PTY_SHELL=/opt/homebrew/bin/zsh
# PTY_CWD=/Users/you

# Optional Cursor plan-usage override for the sidebar meter. When unset, the
# console reads the signed-in Cursor IDE token from local state.vscdb.
# CURSOR_ACCESS_TOKEN=
# CURSOR_API_KEY=

# In Clerk Dashboard → Domains / Allowed origins, add:
#   http://localhost:3100
#   http://127.0.0.1:3100
#
# Also allow the OAuth return path (Paths / Redirect URLs, depending on Clerk UI):
#   http://localhost:3100/sso-callback
#   http://127.0.0.1:3100/sso-callback
#
# Without those, GitHub connect after verification can bounce to the production
# app home (https://backsteros.com/app) instead of this console.
