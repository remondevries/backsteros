# Browser-safe Clerk key. Required for sign-in.
# Without it the admin shows a configure-auth screen.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Optional server Clerk key (needed if you add Clerk middleware later).
CLERK_SECRET_KEY=

# API origin only (no /api/v1 suffix). The Next app proxies /api/v1/* and
# /api/health here (avoids CORS). Use production or local:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8787
NEXT_PUBLIC_API_URL=https://service.backsteros.com

# Production path prefix (omit for local next dev on port 3200):
# NEXT_PUBLIC_BASE_PATH=/admin

# In Clerk Dashboard → Domains / Allowed origins, add:
#   http://localhost:3200
#   http://127.0.0.1:3200
